# Clerk Authentication
# Get your publishable key from https://dashboard.clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase Database
# Get your URL and anon key from https://app.supabase.com/
VITE_NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google OAuth (optional - configured in Clerk dashboard)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Push Notifications (optional)
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here
